{
  "manifest_version": 3,
  "name": "Oyenza Browser Bridge",
  "version": "0.1.0",
  "description": "Shows local CRM and WhatsApp Web events in Oyenza Studio.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://crm-rubin.vercel.app/*",
    "https://web.whatsapp.com/*",
    "http://127.0.0.1:32148/*"
  ],
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Oyenza Browser Bridge" },
  "content_scripts": [
    {
      "matches": ["https://crm-rubin.vercel.app/*"],
      "js": ["content-crm.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content-whatsapp.js"],
      "run_at": "document_idle"
    }
  ]
}
